---
import {useTranslation} from '../lib/i18n';

type Props = {
	lang?: string;
};

const lang = (Astro.props.lang ?? 'it') as 'it' | 'en';
const t = useTranslation(lang);
const altLang = lang === 'it' ? 'en' : 'it';
const regex = /^\/[a-z]{2,2}/g;
---

<div class="px-10 pt-8 pb-2 bg-gray-800 text-white shadow-inner">
	<div class="text-center">
		<span class="font-title uppercase tracking-wider text-4xl">Executable</span><br />
		{t('di')} Carlo Dell'Acqua /
		<span title="P.IVA" class="text-sm">IT 11238940966</span>
	</div>
	<div class="mt-6 text-center">
		<span title="Telefono">+39 375 502 4577</span><br />
		<span title="Città">Reggio Emilia</span><br />
	</div>
	<div class="mt-6 text-center">
		{
			altLang === 'en' ? (
				<>
					<span>Looking for English? </span>
					<a class="underline text-sky-300" href={Astro.url.pathname.replace(regex, `/${altLang}`)}>
						Click here!
					</a>
				</>
			) : (
				<>
					<span>Stai cercando la versione italiana? </span>
					<a class="underline text-sky-300" href={Astro.url.pathname.replace(regex, `/${altLang}`)}>
						Clicca qui!
					</a>
				</>
			)
		}
	</div>
	<div data-nosnippet class="my-8 text-center">
		&mdash; Business Card &mdash;<br />
		<code>curl -sL executable.it/card</code><br />
		<code>Invoke-RestMethod executable.it/card</code><br />
		<button
			class="underline"
			type="button"
			onclick="window.open('/card-bw', '', 'width=500,height=400,status=yes,toolbar=no,menubar=no,resizable=yes,scrollbars=yes')"
			>[{t('anteprima per browser')}]</button
		>
	</div>
	<div class="text-center text-sm mt-10 text-gray-200">
		© 2022 | <a class="underline" href={`/${lang}/privacy`}>{t('Privacy Policy')}</a>
	</div>
</div>

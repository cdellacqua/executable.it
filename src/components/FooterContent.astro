---
import {useTranslation} from '../lib/i18n';

type Props = {
	lang?: string;
};

const lang = (Astro.props.lang ?? 'it') as 'it' | 'en';
const t = useTranslation(lang);
const altLang = lang === 'it' ? 'en' : 'it';
const regex = /^\/[a-z]{2,2}/g;
---

<div class="pt-8 px-2 pb-2 2xs:px-8">
	<div class="text-white text-sm p-8 max-w-xs 2xs:max-w-md xs:max-w-lg sm:max-w-xl md:max-w-xl lg:max-w-4xl xl:max-w-6xl w-full mx-auto rounded-xl bg-gray-900 border border-gray-300">
		<div class="flex flex-col md:flex-row md:justify-between">
			<div class="text-center md:text-left">
				<span class="font-title uppercase tracking-wider text-4xl">Executable</span><br />
				{t('di')} Carlo Dell'Acqua /
				<span title="P.IVA">IT 11238940966</span>

				<div class="text-center md:text-left mt-4">
					{t('Telefono')}:
					<span title={t('Telefono')}>+39 375 502 4577</span><br />
					{t('Email')}:
					<span title={t('Email')}>info@executable.it</span>
				</div>
			</div>
			<div data-nosnippet class="mt-10 md:mt-1 text-center md:text-right">
				&mdash; Business Card &mdash;<br />
				<code class="text-xs">curl -sL executable.it/card</code><br />
				<code class="text-xs">Invoke-RestMethod executable.it/card</code><br />
				<button
					class="underline mt-3"
					type="button"
					onclick="window.open('/card-bw', '', 'width=500,height=400,status=yes,toolbar=no,menubar=no,resizable=yes,scrollbars=yes')"
					>[{t('anteprima per browser')}]</button
				>
			</div>
		</div>
		<div class="flex flex-col md:flex-row md:justify-between mt-10">
			<div class="text-center md:text-left">
				{
					altLang === 'en' ? (
						<>
							<span>Looking for English? </span>
							<a class="underline text-sky-300" href={Astro.url.pathname.replace(regex, `/${altLang}`)}>
								Click here!
							</a>
						</>
					) : (
						<>
							<span>Stai cercando la versione italiana? </span>
							<a class="underline text-sky-300" href={Astro.url.pathname.replace(regex, `/${altLang}`)}>
								Clicca qui!
							</a>
						</>
					)
				}
			</div>
			<div class="text-center md:text-right text-gray-200 mt-12 md:mt-0">
				© 2026 | Milano | <a class="underline" href={`/${lang}/privacy`}>{t('Privacy Policy')}</a>
			</div>
		</div>
	</div>
</div>

---
import '../styles/fonts.css';
import '../styles/global.css';
type Props = {
	title?: string;
	description?: string;
	robots?: string;
	ldJson?: string;
	keywords?: string;
	lang: 'it' | 'en';
};
const {title = '', description = '', robots, ldJson, keywords, lang} = Astro.props;

const altLang = lang === 'it' ? 'en' : 'it';
const regex = /^\/[a-z]{2,2}/g;

const trailingSlashRegex = /\/$/g;
---

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
<meta name="description" property="og:description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
{robots && <meta name="robots" content={robots} />}
{/* <meta name="generator" content={Astro.generator} /> */}
<title>{title}</title>

<meta property="og:type" content="website" />
<meta property="og:url" content={'https://www.executable.it' + Astro.url.pathname.replace(trailingSlashRegex, '')} />
<meta property="og:image" content="https://www.executable.it/assets/og-image.jpg" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="720" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="author" content="Carlo Dell'Acqua" />

<meta name="theme-color" content="#e2e2e2" />
<meta name="apple-mobile-web-app-status-bar" content="#e2e2e2" />

<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
<link rel="apple-touch-icon" href="/assets/favicon-128.png" />

{
	(Astro.url.pathname.startsWith('/en') || Astro.url.pathname.startsWith('/it')) && (
		<link rel="alternate" hreflang={altLang} href={Astro.url.pathname.replace(regex, `/${altLang}`)} />
	)
}

{ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}

---
import FooterContent from './FooterContent.astro';
import MainHead from './MainHead.astro';
import Nav from './Nav.astro';

type Props = {
	lang?: 'it' | 'en';
	robots?: string;
	title?: string;
	description?: string;
	ldJson?: string;
	keywords?: string;
};

const {title = '', description = '', lang = 'it', robots, ldJson, keywords} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<MainHead lang={lang} title={title} description={description} robots={robots} ldJson={ldJson} keywords={keywords} />
	</head>
	<body class="relative min-h-screen z-0">
		<Nav lang={lang} />
		<main class="min-h-screen relative z-10 bg-inherit pb-px">
			<slot />
		</main>
		<footer class="">
			<FooterContent lang={lang} />
		</footer>
	</body>
</html>

---
import FooterContent from './FooterContent.astro';
import MainHead from './MainHead.astro';
import Nav from './Nav.astro';

type Props = {
	lang?: string;
	title?: string;
	description?: string;
};

const {title = '', description = '', lang = 'it'} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body class="relative min-h-screen z-0">
		<Nav lang={lang} />
		<main class="min-h-screen relative z-10 bg-inherit pb-px">
			<slot />
		</main>
		<footer class="">
			<FooterContent />
		</footer>
	</body>
</html>

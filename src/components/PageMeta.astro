---
import LangLinks from './LangLinks.astro';
import {useTranslation} from '../lib/i18n';

type Props = {
	lang: 'it' | 'en';
	to?: 'privacy' | 'home';
};

const {lang, to = 'privacy'} = Astro.props;
const t = useTranslation(lang);
const href = to === 'home' ? `/${lang}` : `/${lang}/privacy`;
const label = to === 'home' ? t("Torna all'homepage") : t('Privacy Policy');
---

<div class="page-meta">
	<LangLinks lang={lang} />
	<span aria-hidden="true" class="page-meta-dot">·</span>
	<a class="page-meta-link" href={href}>{label}</a>
</div>

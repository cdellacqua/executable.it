---
import Footer from './Footer.astro';
import MainHead from './MainHead.astro';

type Props = {
	lang?: string;
	title?: string;
	description?: string;
};

const {title = '', description = '', lang} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body class="relative min-h-screen z-0">
		<main class="min-h-screen relative z-10 bg-inherit neumorph-element protrude no-padding">
				<slot />
		</main>
		<div class="invisible">
			<Footer />
		</div>
		<Footer class="fixed bottom-0 left-0 right-0 z-0" />
	</body>
</html>

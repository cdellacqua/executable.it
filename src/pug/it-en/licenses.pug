extends ../_layout.pug
block main
	.fill-height.first-scroll-height.vertical-center
		section.padding
			.container
				.columns
					.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
						h1(data-reveal="opacity")
							span.elevation=__('Licenze')
						h2(data-reveal="opacity")
							span.underline=__('Licenze dei componenti utilizzati per realizzare questo sito')
						.container(data-reveal="opacity")
							.columns(style="margin-top: 1rem;")
								.col-9
									label.important-label Font Awesome
								.col-3
									a(href="/licenses/OFL-Font%20Awesome.txt" title="Licenza Font Awesome" download) OFL
							.columns(style="margin-top: 1rem;")
								.col-9
									label.important-label Font Awesome SVG
								.col-3
									a(href="/licenses/CC%20BY%204.0-Font%20Awesome%20SVG.txt" title="Licenza Font Awesome SVG" download) CC BY 4.0
							.columns(style="margin-top: 1rem;")
								.col-9
									label.important-label postcss-flexbugs-fixes
								.col-3
									a(href="/licenses/MIT-postcss-flexbugs-fixes.txt" title="Licenza postcss-flexbugs-fixes" download) MIT
							.columns(style="margin-top: 1rem;")
								.col-9
									label.important-label Spartan Font
								.col-3
									a(href="/licenses/OFL-Spartan%20Font.txt" title="Licenza Spartan Font" download) OFL
							.columns(style="margin-top: 1rem;")
								.col-9
									label.important-label Spectre.css
								.col-3
									a(href="/licenses/MIT-Spectre.css.txt" title="Licenza Spectre.css" download) MIT
							.columns(style="margin-top: 1rem;")
								.col-9
									label.important-label Work Sans Font
								.col-3
									a(href="/licenses/OFL-Work%20Sans%20Font.txt" title="Licenza Work Sans Font" download) OFL

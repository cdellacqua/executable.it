extends ../_layout.pug
block main
	section.fill-height.padding.vertical-center.text-center.first-scroll-height
		.container
			.columns
				.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
					h1
						span.elevation 404 | #{__('Pagina non trovata')}
					p=__("La pagina non è stata trovata, l'URL potrebbe essere errato o relativo ad un contenuto non più disponibile.")
					p
						a(href="/it" title=__("Torna all'homepage"))=__("Torna all'homepage")

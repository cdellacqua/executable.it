extends ../_layout.pug
block main
	.background-small
		section.fill-height.first-scroll-height.padding.vertical-center
			.container
				.columns
					.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
						h1(data-reveal="opacity")
							span.elevation=__('Contatti')
						p(data-reveal="fly-in" data-from="bottom")
							=__('Se hai un\'idea che richiede una consulenza specialistica puoi contattarmi senza impegno compilando il seguente form o inviandomi un\'email all\'indirizzo riportato di seguito.')
			div
				include ../common/_form.pug

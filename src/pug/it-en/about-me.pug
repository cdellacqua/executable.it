extends ../_layout.pug
block main
	.fill-height.first-scroll-height
		section.padding
			.container
				.columns
					.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
						.async-img-container.photo-container(data-reveal="fly-in" data-from="right")
							.async-img-placeholder(data-ratio="1.0")
								img(src="/img/me.jpg" class="async-img" alt="me")
							i.loading.loading-lg
						h1(data-reveal="opacity")
							span.elevation=__('Chi sono?')
						h2(data-reveal="fly-in" data-from="bottom")
							span.underline=__('Carlo Dell\'Acqua: sviluppatore multipiattaforma')
						p(data-reveal="fly-in" data-from="bottom")
							=__(`Ho avuto esperienze in ambito di applicativi Desktop e Mobile, ho sperimentato con dispositivi embedded e ho sviluppato progetti basati su microcontrollori, fino ad arrivare alle Web App moderne.`)
						p(data-reveal="fly-in" data-from="bottom")
							=__(`Sviluppo soluzioni valutando la piattaforma e lo stack tecnologico più adatto per ogni progetto.`)
						.socials-container.col-mx-auto
							.columns
								.col-6.column(data-reveal="fly-in" data-from="left")
									a.btn.d-block(title=__("Profilo GitHub") target="_blank" rel="noopener"
										href="https://github.com/cdellacqua")
										i.fab.fa-github-square
										| &nbsp;
										=__('Profilo GitHub')
								.col-6.column(data-reveal="fly-in" data-from="right")
									a.btn.d-block(title=__("Profilo LinkedIn") target="_blank" rel="noopener"
										href="https://www.linkedin.com/in/carlo-dell-acqua/")
										i.fab.fa-linkedin
										| &nbsp;
										=__('Profilo LinkedIn')
		section.padding
			.container
				.columns
					.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
						h2(data-reveal="fly-in" data-from="bottom")
							span.underline=__('Competenze')
						p(data-reveal="fly-in" data-from="bottom")
							=__('Il mio viaggio nello sviluppo Web è iniziato dai classici JavaScript con jQuery e Bootstrap fino ad arrivare ai framework Frontend Angular e Svelte.')
						p(data-reveal="fly-in" data-from="bottom")
							=__('Parallelamente allo studio dello sviluppo Frontend ho iniziato a formarmi sulle tecnologie di Backend, in particolare specializzandomi su Node.js, al fine di poter realizzare Web App complete.')
						p(data-reveal="fly-in" data-from="bottom")
							=__("Coperte le tecnologie ho approfondito le piattaforme, focalizzandomi principalmente su Linux e i container, raggiungendo un buon grado di dimestichezza con lo scripting POSIX, la composizione dei comandi tramite pipeline e la gestione dei servizi con systemd e journald.")
						p(data-reveal="fly-in" data-from="bottom")
							=__("Ad oggi mi occupo di realizzare soluzioni pensate su misura per le esigenze specifiche di ogni cliente, cercando quando possibile di proporre prodotti innovativi.")
		section.padding(style="margin-bottom: 3em;")
			.container
				.columns
					.timeline.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
						h2(data-reveal="fly-in" data-from="bottom")
							span.underline Milestones
						.timeline-item
							.timeline-left
								span.timeline-icon.icon-lg(style="padding: 3px;")
									img(alt="x" style="display: block; height:auto; width: 100%;" src="/img/logo-symbol-white.svg")
							.timeline-content
								.tile
									.tile-content
										p.tile-subtitle(data-reveal="fly-in" data-from="right")=__('aprile 2020')
										h3.tile-title(data-reveal="fly-in" data-from="right")
											span.underline=__('Nasce EXECUTABLE')
										p.tile-text(data-reveal="fly-in" data-from="right")
											=__("Inizia la mia avventura imprenditoriale")
						.timeline-item
							.timeline-left
								span.timeline-icon.icon-lg(style="padding: 3px;")
									i.fas.fa-graduation-cap
							.timeline-content
								.tile
									.tile-content
										p.tile-subtitle(data-reveal="fly-in" data-from="right")=__('settembre 2019')
										h3.tile-title(data-reveal="fly-in" data-from="right")
											span.underline=__('Laurea Triennale in Ingegneria Informatica')
										p.tile-text(data-reveal="fly-in" data-from="right")
						.timeline-item
							.timeline-left
								span.timeline-icon.icon-lg(style="padding: 3px;")
									i.fas.fa-briefcase
							.timeline-content
								.tile
									.tile-content
										p.tile-subtitle(data-reveal="fly-in" data-from="right")=__('marzo 2018')
										h3.tile-title(data-reveal="fly-in" data-from="right")
											span.underline=__('Assunzione presso TCommunication Srl')
										p.tile-text(data-reveal="fly-in" data-from="right")
											=__('Parallelamente alla carriera accademica vengo assunto come sviluppatore IT, iniziando ad applicare le conoscenze acquisite negli anni per la realizzazione di prodotti digitali.')
						.timeline-item
							.timeline-left
								span.timeline-icon.icon-lg(style="padding: 3px;")
									i.fas.fa-graduation-cap
							.timeline-content
								.tile
									.tile-content
										p.tile-subtitle(data-reveal="fly-in" data-from="right")=__('luglio 2016')
										h3.tile-title(data-reveal="fly-in" data-from="right")
											span.underline=__('Diploma in Informatica e Telecomunicazioni')
										p.tile-text(data-reveal="fly-in" data-from="right")

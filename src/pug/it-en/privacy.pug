extends ../_layout.pug
block main
	.background-small.fill-height.first-scroll-height
		section.padding
			.container
				.columns
					.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto
						h1(data-reveal="opacity")
							span.elevation=__("Privacy Policy")
						h2(data-reveal="opacity")
							span.underline=__("Titolare del trattamento dei dati")
						p(data-reveal="opacity")
							=__("Il Titolare del trattamento è Carlo Dell'Acqua, sede legale in via Martino Lutero 4, CAP 20126, Milano (MI), Partita IVA 11238940966.")
							br
							=__("Indirizzo e-mail")+':'
							|
							|
							span.eaddress.tooltip.tooltip-right(data-copy="afngHmpmk}|ijdm&a|" data-tooltip-copied=__("Copiato!") data-tooltip-hover=__("Clicca per copiare"))
								img(src="/img/eaddress-info.svg" alt="eaddress" style="height: .925em; width: auto; vertical-align: middle;")
						h2(data-reveal="opacity")
							span.underline=__("Dati raccolti")
						p(data-reveal="opacity")
							=__("Questo sito web raccoglie in modalità automatica i seguenti dati:")
						ul(data-reveal="opacity")
							li=__("indirizzo IP")
							li=__("token di sessione")
							li=__("data e ora di accesso alle pagine")
							li=__("dati di navigazione trasmessi dal browser")
						p(data-reveal="opacity")
							=__("Previo inserimento e consenso esplicito da parte dell'utente il sito può inoltre raccogliere dati personali:")
						ul(data-reveal="opacity")
							li=__("nome")
							li=__("cognome")
							li=__("indirizzo e-mail")
							li=__("numero di telefono")
						p(data-reveal="opacity")
							=__("L'utente si assume la responsabilità dei dati personali di terzi ottenuti, pubblicati o condivisi mediante questo sito e garantisce di avere il diritto di comunicarli e/o diffonderli, liberando il titolare da qualsiasi responsabilità verso terzi.")
						h2(data-reveal="opacity")
							span.underline=__("Finalità dei dati raccolti")
						p(data-reveal="opacity")
							=__("I dati raccolti verranno utilizzati per le seguenti finalità:")
						.container(data-reveal="opacity")
							.columns(style="margin-top: 1rem;margin-bottom: 1rem;")
								.col-3.col-xl-4.col-sm-12
									label.important-label=__("Contatto")
								.col-9.col-xl-8.col-sm-12=__("I dati personali liberamente comunicati dall'utente verranno utilizzati per un successivo ricontatto telematico o telefonico da parte del titolare del trattamento dei dati.")
							.columns(style="margin-top: 1rem;margin-bottom: 1rem;")
								.col-3.col-xl-4.col-sm-12
									label.important-label=__("Statistica")
								.col-9.col-xl-8.col-sm-12=__("I dati di utilizzo anonimi degli utenti verranno utilizzati al fine di migliorare la qualità del servizio mediante analisi di carattere statistico riguardanti, a titolo esemplificativo e non esaustivo, i contenuti più visitati, i tempi medi delle sessioni di navigazione e i tempi medi di risposta del server. Le finalità espresse in questo punto non necessitano di esplicito consenso secondo quanto previsto dall'art. 6 lett. f del GDPR")
						h2(data-reveal="opacity")
							span.underline=__("Modalità del trattamento")
						h3(data-reveal="opacity")=__("Conservazione e cancellazione")
						p(data-reveal="opacity")
							=__("I Dati Personali saranno conservati per il periodo di tempo necessario al perseguimento delle finalità per cui tali dati sono stati raccolti e per l'assolvimento degli obblighi di Legge vigenti.")
						p(data-reveal="opacity")
							=__("Tali Trattamenti hanno luogo presso la sede del Titolare e/o presso i Responsabili Ulteriori del trattamento che effettuano il trattamento per conto del Titolare, all'interno dello Spazio Economico Europeo.")
						p(data-reveal="opacity")
							=__("In qualsiasi momento l'utente potrà richiedere la copia e/o la cancellazione dei propri Dati Personali dal sistema scrivendo una email di richiesta alla casella di posta elettronica indicata in questo documento. Con la medesima modalità di comunicazione l'utente può richiedere la revoca dei consensi per le finalità indicate.")
						p(data-reveal="opacity")
							=__("Al termine del periodo di conservazione, i Dati Personali saranno cancellati e conseguentemente il diritto di accesso, cancellazione, rettificazione ed il diritto alla portabilità dei dati non potranno più essere esercitati dall'utente.")
						h3(data-reveal="opacity")=__("Base giuridica del trattamento")
						p(data-reveal="opacity")
							=__("Il titolare tratta i dati personali relativi all'utente qualora sussista una delle seguenti condizioni:")
						ul(data-reveal="opacity")
							li=__("l'utente ha fornito consenso esplicito per una o più finalità indicate in fase di comunicazione dei dati")
							li=__("il trattamento è necessario per adempiere un obbligo legale al quale è soggetto il titolare")
							li=__("il trattamento è necessario per il perseguimento del legittimo interesse del titolare")
						h2(data-reveal="opacity")
							span.underline=__("Diritti dell'utente")
						p(data-reveal="opacity")
							=__("L'utente ha il diritto di:")
						ul(data-reveal="opacity")
							li=__("revocare qualunque consenso precedentemente concesso")
							li=__("opporsi al trattamento dei dati qualora questo avvenisse su una base giuridica differente dai consensi espressi")
							li=__("ricevere una copia dei propri dati personali in un formato strutturato per autoconsultazione e/o per il trasferimento presso altro titolare")
							li=__("verificare e richiedere la rettificazione dei dati personali comunicati")
							li=__("richiedere la completa cancellazione dei propri dati personali")
							li=__("proporre un reclamo presso l'autorità di controllo della protezione dei dati competente o agire in sede giudiziale")
						p(data-reveal="opacity")
							=__("I diritti di cui sopra possono essere esercitati dall'utente inoltrando esplicita richiesta al titolare agli estremi indicati in questo documento. Le richieste saranno evase dal titolare entro un mese dalla ricezione della richiesta.")
						h4(data-reveal="opacity")=__("Modifiche alla Privacy Policy")
						p(data-reveal="opacity")
							=__("Il titolare si riserva il diritto di apportare modifiche alla presente Privacy Policy in qualunque momento notificandolo agli utenti su questa pagina e, se possibile, inviando una notifica agli utenti attraverso uno degli estremi di contatto di cui è in possesso. Qualora le modifiche interessino trattamenti la cui base giuridica è il consenso, il titolare provvederà, se necessario, a raccogliere nuovamente il consenso dell'utente.")
				.columns(data-reveal="opacity")
					.col-6.col-xl-8.col-lg-10.col-sm-12.col-mx-auto.text-right
						small=__("Milano, 21 Gennaio 2021")

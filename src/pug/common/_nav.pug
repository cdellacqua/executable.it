.links-wrapper
	ul.tab.tab-block(data-tooltip=__('Tu sei qui'))
		li.tab-item.hide-md &nbsp;
		li.tab-item
			a(href='/'+lang title=__('Home'))=__('Home')
		li.tab-item
			a(href='/'+lang+'/about-me' title=__('Chi sono'))
				span.hide-xs=__('Chi sono')
				span.show-xs.hide-sm=__('About')
		li.tab-item
			a(href='/'+lang+'/contacts' title=__('Contatti'))=__('Contatti')
		li.tab-item
			a(href='/'+lang+'/projects' title=__('Progetti'))=__('Progetti')
		include _lang-switch.pug

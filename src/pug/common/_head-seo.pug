meta(property="og:type" content='website')
meta(property="og:url" content=WEBSITE_URL+'/'+lang+('/'+basenameNoExt).replace('/index',''))
meta(property="og:image" content=WEBSITE_URL+'/img/og-image.png?v=1')
meta(property="og:image:width" content='1000')
meta(property="og:image:height" content='527')
meta(name="twitter:card" content='summary_large_image')

meta(name="author" content='Carlo Dell\'Acqua')
meta(name="keywords" content=seo[basenameNoExt].keywords[lang])
title=seo[basenameNoExt].title[lang]
meta(name="description" content=seo[basenameNoExt].description[lang])
if seo[basenameNoExt].robots
	meta(name="robots" content=seo[basenameNoExt].robots)

link(rel="alternate" hreflang=(lang === 'it' ? 'en' : 'it') href='/'+(lang === 'it' ? 'en' : 'it')+('/'+basenameNoExt).replace('/index',''))
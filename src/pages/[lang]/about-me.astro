---
import Page from '../../components/Page.astro';
import {getTranslationStaticPaths, useTranslation} from '../../lib/i18n';

export const getStaticPaths = getTranslationStaticPaths;

const lang = String(Astro.params.lang ?? 'it') as 'it' | 'en';

const t = useTranslation(lang);
---

<Page title={t('Chi sono')} description={t("Carlo Dell'Acqua - Sviluppatore multipiattaforma")} lang={lang}>
	<section class="w-full relative h-screen flex flex-col lg:flex-row items-center justify-center bg-gray-200">
		<div
			class="max-w-xs md:max-w-xl lg:max-w-2xl w-full border border-gray-200 bg-gray-100 shadow-xl rounded-xl overflow-hidden z-0 relative -rotate-3"
		>
			<div
				class="py-6 px-6 md:py-8 md:px-10 lg:py-12 lg:px-12 lg:pr-16 flex flex-col justify-between bg-gray-50 shadow-xl rounded-xl overflow-hidden"
			>
				<div class="pb-4 md:pb-8 lg:pb-12">
					<h1 class="text-2xl md:text-4xl lg:text-6xl font-title">Carlo Dell'Acqua</h1>
					<h2 class="pl-4 font-bold text-lg md:text-xl lg:text-2xl text-sky-600">
						{t('Sviluppatore multipiattaforma')}
					</h2>
				</div>
				<div class="text-4xl lg:text-6xl">
					<div class="flex flex-row flex-wrap items-center justify-between">
						<div class="text-center w-1/2 mb-6 md:mb-0 md:w-1/4">
							<i class="fa-solid fa-cloud text-sky-300"></i>
							<div class="text-base md:text-lg lg:text-xl mt-1 font-bold">{t('Web')}</div>
						</div>
						<div class="text-center w-1/2 mb-6 md:mb-0 md:w-1/4">
							<i class="fa-solid fa-server text-gray-400"></i>
							<div class="text-base md:text-lg lg:text-xl mt-1 font-bold">{t('Server')}</div>
						</div>
						<div class="text-center w-1/2 md:w-1/4">
							<i class="fa-solid fa-mobile-screen-button text-sky-600"></i>
							<div class="text-base md:text-lg lg:text-xl mt-1 font-bold">{t('Mobile')}</div>
						</div>
						<div class="text-center w-1/2 md:w-1/4">
							<i class="fa-solid fa-display text-slate-600"></i>
							<div class="text-base md:text-lg lg:text-xl mt-1 font-bold">{t('Desktop')}</div>
						</div>
					</div>
				</div>
			</div>
			<div class="py-6 px-6 lg:px-12 lg:pr-16">
				<div class="flex flex-row justify-center space-x-8">
					<a class="" title={t('Profilo GitHub')} target="_blank" rel="noopener" href="https://github.com/cdellacqua"
						><i class="text-gray-600 fa-brands fa-github"></i>&nbsp;&nbsp;<span class="hidden md:inline"
							>{t('Profilo GitHub')}
						</span><span class="md:hidden">{t('GitHub')}</span>
					</a>
					<a
						class=""
						title={t('Profilo LinkedIn')}
						target="_blank"
						rel="noopener"
						href="https://www.linkedin.com/in/carlo-dell-acqua/"
						><i class="text-gray-600 fa-brands fa-linkedin-in"></i>&nbsp;&nbsp;<span class="hidden md:inline"
							>{t('Profilo LinkedIn')}
						</span><span class="md:hidden">{t('LinkedIn')}</span>
					</a>
				</div>
			</div>
		</div>
		<div
			class="shadow-xl border border-gray-200 overflow-hidden lg:-ml-8 rounded-xl p-2 z-10 relative rotate-3 h-52 lg:h-72 bg-white"
		>
			<div class="rounded-lg overflow-hidden h-full">
				<img
					src="/assets/me-transparent.png"
					alt={t('Foto profilo')}
					width="686"
					height="686"
					class="w-auto h-full relative z-0"
				/>
			</div>
		</div>
		<!-- <div
			class="shadow-xl border border-gray-200 mt-8 lg:mt-0 lg:-ml-8 rounded-xl p-2 z-10 relative rotate-3 w-52 h-52 lg:w-72 lg:h-72 bg-white"
		>
			<div class="w-full h-[125%] absolute overflow-hidden inset-x-0 bottom-0 rounded-xl">
				<img
					src="/assets/me-transparent.png"
					alt={t('Foto profilo')}
					width="686"
					height="686"
					class="w-full h-auto scale-125 origin-bottom absolute bottom-0 inset-x-0"
				/>
			</div>
		</div> -->
	</section>
</Page>

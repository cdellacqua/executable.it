---
import Page from '../../components/Page.astro';
import {getTranslationStaticPaths, useTranslation} from '../../lib/i18n';
import sizeOf from 'image-size';
import {join} from 'path';
import {ProjectTooltip} from '../../components/preconfigured/projects/ProjectTooltip';

export const getStaticPaths = getTranslationStaticPaths;

const lang = String(Astro.params.lang ?? 'it') as 'it' | 'en';

const t = useTranslation(lang);

function aspectRatio({width, height}: {width: number; height: number}) {
	return width / height;
}

function urlToPath(url: string) {
	return join('public', ...url.split('/').filter(Boolean));
}

function aspectRatioOf(url: string) {
	return aspectRatio(sizeOf(urlToPath(url)) as any);
}

const partialProjects: Array<{
	name: string | {it: string; en: string};
	description: {
		it: string;
		en: string;
	};
	url?: string;
	urlText?: string;
	imgUrl: string;
	company: {
		name: string;
		url: string;
		imgUrl: string;
	};
}> = [
	{
		name: {
			it: 'Piattaforma di investimenti',
			en: 'Investment platform',
		},
		description: {
			it: `Piattaforma per investitori istituzionali basata su AI. All'interno del team di frontend, ho aiutato a prendere decisioni tecniche e strategiche e ho realizzato diverse parti dell'applicativivo, tra cui il flusso di creazione dei portafogli e il chatbot. L'intera piattaforma frontend è sviluppata con React.`,
			en: `Investment platform for institutional investors powered by AI. I joined the frontend team, helping with technical and strategical decisions. I developed several sections of the application, including the portfolio creation funnel and the chatbot. The frontend is developed using React.`,
		},
		imgUrl: '/assets/projects/investment-platform.jpg',
		company: {
			name: 'BindingFuture',
			url: 'https://www.bindingfuture.com/',
			imgUrl: '/assets/projects/companies/binding-future-small.jpg',
		},
	},
	{
		name: {
			it: 'App white label per istituti di vigilanza',
			en: 'White label app for private security companies',
		},
		description: {
			it: `Applicazione white label per Android e iOS sviluppata con React Native. Peculiarità di questa applicazione è il sistema di temi parametrico, che permette di pubblicarne versioni differenti con loghi e colori specifici per ciascun istituto.`,
			en: `App for Android and iOS developed with React Native. The main feature of this app is the theming system that is used to quickly customise images and colours for specific companies.`,
		},
		imgUrl: '/assets/projects/vigilanza-squared.jpg',
		company: {
			name: 'BindingFuture',
			url: 'https://www.bindingfuture.com/',
			imgUrl: '/assets/projects/companies/binding-future-small.jpg',
		},
	},
	{
		name: {
			it: 'App per la gestione di misuratori elettrici industriali',
			en: 'App for managing industrial power meters',
		},
		description: {
			it: `Applicazione per Android e iOS sviluppata con React Native che permette a personale tecnico di comunicare tramite Bluetooth Low Energy con dispositivi di misurazione di impianti elettrici industriali. L'applicazione permette di configurarne il funzionamento e scaricare dati provenienti dai vari sensori installati.`,
			en: `App for Android and iOS developed with React Native used by technicians to interact via Bluetooth Low Energy with industrial power measuring devices. The application lets the user configure such devices and download data coming from their sensors.`,
		},
		imgUrl: '/assets/projects/setup-for-measuring-device-squared.jpg',
		company: {
			name: 'BindingFuture',
			url: 'https://www.bindingfuture.com/',
			imgUrl: '/assets/projects/companies/binding-future-small.jpg',
		},
	},
	{
		name:{
			it: 'Dashboard per la gestione di interruttori industriali',
			en: 'Dashboard for managing industrial breakers'
		},
		description: {
			it: `Web app sviluppata con React che permette a personale tecnico di visualizzare dati storici e correnti provenienti dai sensori presenti in diversi modelli di interruttori industriali smart.`,
			en: `Web app developed with React used by technicians to monitor and visualise aggregated and current sensor data provided by different families of smart industrial circuit breakers.`,
		},
		imgUrl: '/assets/projects/dashboard-for-breakers.jpg',
		company: {
			name: 'BindingFuture',
			url: 'https://www.bindingfuture.com/',
			imgUrl: '/assets/projects/companies/binding-future-small.jpg',
		},
	},
	{
		name: 'Journhey',
		description: {
			it: `Social Network sperimentale orientato al mondo dei viaggi. Ho sviluppato la web app tramite SvelteKit.`,
			en: `Experimental Social Network designed for travelers who want to share their experience. I developed the web app using SvelteKit.`,
		},
		url: 'https://journhey.com/',
		urlText: 'Journhey',
		imgUrl: '/assets/projects/journhey.jpg',
		company: {
			name: 'Journhey',
			url: 'https://journhey.com/',
			imgUrl: '/assets/projects/companies/journhey.jpg',
		},
	},
	{
		name: 'Smart Parking',
		description: {
			it: `Piattaforma di monitoraggio delle aree di parcheggio che analizza video provenienti da telecamere di rete. Ho costruito l'infrastruttura di rete e integrato il servizio di analisi remota del flusso video. Per questo progetto ho realizzato una serie di applicazioni e script per Linux, sia per il server centrale, sia per i singoli dispositivi installati nelle sedi di monitoraggio.`,
			en: `Monitoring Platform for parking lots that analyzes video streams coming from IP Cameras. I built the network infrastructure and integrated the video analysis service. For this project, I developed several applications and scripts targeting Linux, both for the main server and for the devices installed in the parking lots.`,
		},
		imgUrl: '/assets/projects/smart-parking.jpg',
		company: {
			name: 'Huna',
			url: 'https://huna.io/',
			imgUrl: '/assets/projects/companies/huna-alt-small.jpg',
		},
	},
	{
		name: 'Edoco',
		description: {
			it: `Progressive Web App per l'emissione di documenti commerciali. Ho realizzato il backend con Express.js e il frontend con Svelte. L'applicazione gestisce invio telematico, integrazione con stampanti termiche e listino prodotti/servizi.`,
			en: `Progressive Web App that handles receipts. I developed both the backend and the frontend using Express.js and Svelte. The app provides a friendly user interface for creating and storing receipts online as well as an integration with thermal printers.`,
		},
		url: 'https://edoco.it/',
		urlText: 'edoco.it',
		imgUrl: '/assets/projects/edoco.jpg',
		company: {
			name: 'Edoco',
			url: 'https://edoco.it/',
			imgUrl: '/assets/projects/companies/edoco-small.jpg',
		},
	},
	{
		name: 'Cube H24 Web',
		description: {
			it: `Applicativo che aggrega dati provenienti da diversi sensori. Mi sono occupato di realizzare un Proof of Concept convertendo alcune sezioni dell'applicazione desktop esistente in una Progressive Web App basata su Svelte. Tra le funzionalità troviamo la visualizzazione di dati provenienti da sensori ambientali, mappa interattiva per la loro individuazione e visualizzazione di grafici con dati aggregati sull'andamento dei valori.`,
			en: `Application that aggregates data coming for a variety of sensors. I developed a Proof of Concept, porting some sections of the existing Desktop application to a Progressive Web App using Svelte. The web application shows data from various sensors, it provides an interactive map to locate the sensors in a specific area and statistics based on historical data.`,
		},
		imgUrl: '/assets/projects/cube-h24.jpg',
		company: {
			name: 'Stonex',
			url: 'https://www.stonex.it/',
			imgUrl: '/assets/projects/companies/stonex-small.jpg',
		},
	},
	{
		name: 'Light Touch',
		description: {
			it: `Portale per addetti all'installazione di impianti d'illuminazione pubblica. Ho realizzato una nuova sezione nell'applicativo Web Light Touch basato su Angular per la raccolta dei dati d'illuminazione stradale e la visualizzazione delle analisi fotometriche.`,
			en: 'Web portal for professionals who work in street lighting systems. I developed a new section of an Angular web app called Light Touch. This section provides a form that collects data about street lamps, showing a preview of the street and a heatmap based on a photometric analysis.',
		},
		url: 'https://huna.io/light-touch/',
		urlText: 'Huna - Light Touch',
		imgUrl: '/assets/projects/light-touch.jpg',
		company: {
			url: 'https://huna.io/',
			name: 'Huna',
			imgUrl: '/assets/projects/companies/huna-alt-small.jpg',
		},
	},
	{
		name: 'Booking TouchHair',
		description: {
			it: `Portale di prenotazioni rivolto a saloni e parrucchieri. Ho realizzato il backend utilizzando Laravel e il frontend utilizzando Svelte. Tra le funzionalità principali troviamo la gestione degli appuntamenti lato negozio e la prenotazione dei servizi lato cliente con funnel intelligente che trova gli incastri per le prestazioni richieste.`,
			en: 'Booking platform targeting hairdressers and beauty centers. I developed the backend using Laravel and the frontend using Svelte. Using this application, shops can manage appointments through an interactive calendar and customers can make reservations using a funnel that automatically scans for available time slots.',
		},
		url: 'https://booking.touchhair.it/',
		urlText: 'Booking TouchHair',
		imgUrl: '/assets/projects/booking.jpg',
		company: {
			name: 'ICTec',
			url: 'https://www.ictec.it/',
			imgUrl: '/assets/projects/companies/ictec-small.jpg',
		},
	},
];

const projects = partialProjects.map((proj) => ({
	...proj,
	imgRatio: aspectRatioOf(proj.imgUrl),
	company: {
		...proj.company,
		imgRatio: aspectRatioOf(proj.company.imgUrl),
	},
}));
---

<Page
	title={t('Progetti')}
	keywords={t('progetti,lavori')}
	description={t('Qui trovi alcuni dei progetti a cui ho lavorato')}
	lang={lang}
>
	<div class="w-full h-12 md:h-24"></div>
	<div
		class="text-center mt-12 max-w-xs 2xs:max-w-md xs:max-w-lg sm:max-w-xl md:max-w-xl lg:max-w-4xl xl:max-w-6xl w-full mx-auto"
	>
		<h1 class="font-title text-3xl">
			{t('Qui trovi alcuni dei progetti a cui ho lavorato')}
		</h1>
	</div>
	{
		projects.map((project) => (
			<section class="w-full my-24 flex items-center relative">
				<div class="relative max-w-xs 2xs:max-w-md xs:max-w-lg sm:max-w-xl md:max-w-xl lg:max-w-4xl xl:max-w-6xl w-full mx-auto">
					<div class="w-full border border-[#e1e1e1] bg-gray-50 shadow-xl rounded-xl overflow-hidden z-0 relative mx-auto  flex flex-row">
						<div class="hidden xl:block w-1/3 border-r border-gray-200">
							<img class="w-full h-auto" alt={t('Anteprima progetto')} src={project.imgUrl} />
						</div>
						<div class="xl:w-2/3 py-6 px-6 md:py-8 md:px-10 lg:py-12 lg:px-12 lg:pr-16 flex flex-col justify-between overflow-hidden">
							<div class="pb-4 md:pb-8 lg:pb-12">
								<h2 class="text-3xl mb-10 font-title">
									{typeof project.name === 'string' ? project.name : project.name[lang]}
								</h2>
								<p class="">{project.description[lang]}</p>
							</div>
							<div class="flex flex-row justify-end md:-mr-4 md:-mb-3 lg:-mr-10 lg:-mb-6">
								{project.url && (
									<div class="mr-8 xl:mr-0">
										<a
											class="hover:text-gray-600 text-gray-400 transition-colors"
											href={project.url}
											title={project.urlText}
											rel="noreferrer noopener"
											target="_blank"
										>
											<i class="fa-solid fa-arrow-up-right-from-square text-2xl" />
										</a>
									</div>
								)}
								<div class="xl:hidden">
									<ProjectTooltip lang={lang} client:load img={project.imgUrl} />
								</div>
							</div>
						</div>
					</div>
					<div class="absolute left-1/2 -translate-x-1/2 top-0 -translate-y-3/4 md:left-auto md:right-0 md:top-0 md:-translate-y-1/2 md:translate-x-1/4">
						<a
							title={project.company.name}
							class="rounded-xl overflow-hidden block shadow-xl"
							target="_blank"
							rel="noreferrer noopener"
							href={project.company.url}
						>
							<img
								alt={project.company.name}
								src={project.company.imgUrl}
								style={`height: ${200 / project.company.imgRatio}px; width: 200px; max-width: none`}
								class="block"
							/>
						</a>
					</div>
				</div>
			</section>
		))
	}
</Page>

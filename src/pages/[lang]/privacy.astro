---
import Page from '../../components/Page.astro';
import PageMeta from '../../components/PageMeta.astro';
import {getTranslationStaticPaths, useTranslation} from '../../lib/i18n';

export const getStaticPaths = getTranslationStaticPaths;

const lang = String(Astro.params.lang ?? 'it') as 'it' | 'en';

const t = useTranslation(lang);
---

<Page title={t('Privacy Policy')} keywords={t('privacy,policy')} description={t('Privacy Policy')} lang={lang}>
	<div class="privacy">
		<h1 class="privacy-title">
			{t('Privacy Policy')}
		</h1>
		<h2 class="privacy-heading">
			{t('Titolare del Trattamento dei dati')}
		</h2>
		<p class="privacy-copy">
			{t("Il Titolare del Trattamento è Carlo Dell'Acqua.")}
			<br />
			{t('Indirizzo e-mail:')}
			<a class="privacy-mail" target="_blank" href={'mailto:info@executable.it'}>info@executable.it</a>
		</p>
		<h2 class="privacy-heading">
			{t('Dati raccolti')}
		</h2>
		<p class="privacy-copy">
			{
				t(
					'Questo sito non utilizza cookie, non include strumenti di analisi e non raccoglie dati personali tramite le pagine.',
				)
			}
		</p>
		<p class="privacy-copy">
			{
				t(
					'Il server che ospita il sito può registrare automaticamente log tecnici (indirizzo IP, data e ora, URL richiesto, dati trasmessi dal browser) per il funzionamento e la sicurezza del servizio.',
				)
			}
		</p>
		<h2 class="privacy-heading">
			{t("Diritti dell'utente")}
		</h2>
		<p class="privacy-copy">
			{t("L'utente ha il diritto di:")}
		</p>
		<ul class="privacy-list">
			<li>
				{
					t(
						'ricevere una copia dei propri Dati Personali in un formato strutturato per autoconsultazione e/o per il trasferimento presso altro Titolare',
					)
				}
			</li>
			<li>{t('verificare e richiedere la rettificazione dei Dati Personali comunicati')}</li>
			<li>{t('richiedere la completa cancellazione dei propri Dati Personali')}</li>
			<li>
				{
					t(
						"proporre un reclamo presso l'autorità di controllo della protezione dei dati competente o agire in sede giudiziale",
					)
				}
			</li>
		</ul>
		<p class="privacy-copy">
			{
				t(
					"I diritti di cui sopra possono essere esercitati dall'utente inoltrando esplicita richiesta al Titolare agli estremi indicati in questo documento. Le richieste saranno evase dal Titolare entro un mese dalla ricezione della richiesta.",
				)
			}
		</p>
		<h2 class="privacy-heading">{t('Modifiche alla Privacy Policy')}</h2>
		<p class="privacy-copy">
			{
				t(
					'Il Titolare si riserva il diritto di apportare modifiche alla presente Privacy Policy in qualunque momento notificandolo agli utenti su questa pagina.',
				)
			}
		</p>

		<div class="privacy-date">
			<small>{t('Pioltello, 17 Settembre 2026')}</small>
		</div>
		<PageMeta lang={lang} to="home" />
	</div>
</Page>

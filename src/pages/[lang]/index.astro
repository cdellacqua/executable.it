---
import AboutMeCard from '../../components/AboutMeCard.astro';
import Page from '../../components/Page.astro';
import {getTranslationStaticPaths, useTranslation} from '../../lib/i18n';

export const getStaticPaths = getTranslationStaticPaths;

const lang = String(Astro.params.lang ?? 'it') as 'it' | 'en';

const t = useTranslation(lang);

const title = "Carlo Dell'Acqua";
const description = t("Profilo personale di Carlo Dell'Acqua, Software Engineer.");
---

<Page
	title={title}
	description={description}
	lang={lang}
	keywords={t('software,engineer,sviluppo,developer,github,linkedin')}
	ldJson={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: "Carlo Dell'Acqua",
		url: 'https://www.executable.it/',
		jobTitle: t('Software Engineer'),
		sameAs: ['https://github.com/cdellacqua', 'https://www.linkedin.com/in/carlo-dell-acqua/'],
	})}
>
	<section class="flex-1 w-full flex flex-col items-center justify-center p-8">
		<AboutMeCard lang={lang} />
	</section>
</Page>

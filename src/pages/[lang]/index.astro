---
import Page from '../../components/Page.astro';
import {Spaceship} from '../../components/preconfigured/index/Spaceship';
import {VideoInfo} from '../../components/preconfigured/index/VideoInfo';
import {ContactFormSection} from '../../components/preconfigured/shared/ContactFormSection';
import {SectionCard} from '../../components/preconfigured/shared/SectionCard';
import {getTranslationStaticPaths, useTranslation} from '../../lib/i18n';

export const getStaticPaths = getTranslationStaticPaths;

const lang = String(Astro.params.lang ?? 'it') as 'it' | 'en';

const t = useTranslation(lang);

const title = t('Executable - Azienda informatica Reggio Emilia');
const description = t('Servizi di consulenza informatica e realizzazione di applicativi Web a Reggio Emilia');
---

<Page
	title={title}
	description={description}
	lang={lang}
	ldJson={JSON.stringify({
		'@context': 'https://schema.org',
		'@id': 'https://www.executable.it/',
		'@type': 'LocalBusiness',
		openingHoursSpecification: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].flatMap(
			(dayOfWeek) => [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: 'https://schema.org/' + dayOfWeek,
					opens: '10:00:00',
					closes: '12:00:00',
				},
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: 'https://schema.org/' + dayOfWeek,
					opens: '14:00:00',
					closes: '17:00:00',
				},
			],
		),
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Reggio Emilia',
			addressRegion: 'RE',
			postalCode: '42122',
			addressCountry: 'IT',
		},
		url: 'https://www.executable.it/',
		description: description,
		name: title,
		telephone: '+39 375 502 4577',
	})}
>
	<section class="h-screen w-full relative">
		<div class="absolute bottom-2 right-4 z-10">
			<VideoInfo lang={lang} client:load />
		</div>
		<div class="w-full h-full overflow-hidden flex items-center justify-center relative z-0">
			<video
				class="min-w-full min-h-full max-w-none max-h-none -translate-x-1/2 -translate-y-1/2 absolute top-1/2 left-1/2"
				style="background-image: url('/assets/stars-fallback.jpg'); background-size: cover"
				muted=""
				autoplay=""
				loop=""
				playsinline=""
			>
				<source src="/assets/stars.mp4" type="video/mp4" />
				<img src="/assets/stars-fallback.jpg" />
			</video>
		</div>
		<div class="absolute inset-0 z-0 overflow-hidden">
			<Spaceship client:load />
		</div>
	</section>
	<section class="w-full flex items-center my-24">
		<SectionCard>
			<i
				class="fa-solid fa-robot text-gray-200 opacity-85 text-[400px] absolute top-1/2 right-0 z-0 translate-x-1/2 -translate-y-1/2"
			></i>
			<div class="relative z-10">
				<h2 class="text-3xl mb-10 font-title">
					{t('Voglia di automazione?')}
				</h2>
				<p class="mb-2">
					{
						t(
							'Per digitalizzare in maniera innovativa bisogna cercare soluzioni che superino le analogie e i limiti del mondo fisico.',
						)
					}
				</p>
				<p
					class=""
					set:html={t(
						'Executable - che al momento conta una persona, <i>me medesimo ndr</i> - ha come obiettivo aiutare le aziende che hanno <span class="font-semibold">voglia di automazione</span>.',
					)}
				>
				</p>
				<div class="ml-5 mb-10 flex flex-row flex-wrap">
					{
						[
							['fa-solid fa-chart-pie', 'text-sky-400', t('consulenza specialistica')],
							['fa-solid fa-circle-nodes', 'text-yellow-400', t('integrazioni')],
							['fa-solid fa-code', 'text-red-400', t('programmazione')],
							['fa-solid fa-microscope', 'text-gray-400', t('analisi e progettazione')],
						].map(([icon, color, text], i) => (
							<div
								class={`w-full md:w-1/2 mt-10 flex flex-row items-center relative ${
									i % 2 !== 0 ? 'md:flex-row-reverse' : ''
								}`}
							>
								<i
									class={`${icon} block text-4xl relative z-0 opacity-80 mt-0.5 mr-3 ${color} ${
										i % 2 !== 0 ? 'md:mr-0 md:ml-3' : ''
									}`}
								/>
								<span class="block relative z-10 text-lg md:text-xl align-baseline">{text}</span>
							</div>
						))
					}
				</div>
			</div>
		</SectionCard>
	</section>

	<ContactFormSection lang={lang} client:load />

	<!-- <Section>
		<i
			class="fa-solid fa-address-book text-gray-200 opacity-85 text-[400px] absolute top-1/2 right-0 z-0 translate-x-1/2 -translate-y-1/2"
		></i>
		<div class="relative z-10">
			<h2 class="text-3xl mb-10 font-title">
				{t('Collaboriamo!')}
			</h2>
			<ContactForm lang={lang} client:load />
		</div>
	</Section> -->
</Page>

---
import Icon from '../components/Icon.astro';
import Page from '../components/Page.astro';
import PageMeta from '../components/PageMeta.astro';
import SectionCard from '../components/SectionCard.astro';
import {useTranslation} from '../lib/i18n';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'it';

const t = useTranslation(lang);
---

<Page robots="noindex,nofollow" title={t('404 | Pagina non trovata')} description={t('Pagina non trovata')} lang={lang}>
	<section class="not-found">
		<div class="not-found-center">
			<SectionCard class="not-found-card">
				<div class="not-found-body">
					<div class="not-found-stack">
						<Icon name="exclamation" class="not-found-icon" />
						<div class="not-found-copy">
							<h2 class="not-found-title">
								{t('404')}
							</h2>
							<p class="not-found-text">
								{t('Ops! Pagina non trovata')}
								<a class="not-found-home" href="/it">{t("Torna all'homepage")}</a>
							</p>
						</div>
					</div>
				</div>
			</SectionCard>
		</div>
		<PageMeta lang={lang} />
	</section>
</Page>

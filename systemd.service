[Unit]
Description=Executable - Node.js Backend
After=network.target
Wants=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=REDACTED
Group=REDACTED
ExecStart=/usr/bin/npm start
WorkingDirectory=/var/www/executable.it/
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=1
TimeoutStopSec=18s

[Install]
WantedBy=multi-user.target
